        -:  154:// Tab 补全：给定前缀，返回匹配的完整单词（最多 10 个）
        -:  155:inline std::vector<std::string> tab_complete(const std::string &prefix) {
        -:  156:    if (prefix.empty() || !is_english_input(prefix)) return {};
        -:  157:    std::string lower = prefix;
        -:  158:    for (auto &c : lower) if (c >= 'A' && c <= 'Z') c += 32;
        -:  159:    
        -:  160:    std::vector<std::string> result;
        -:  161:    for (const auto &word : english_word_list()) {
        -:  162:        if (word.size() >= lower.size() &&
        -:  163:            word.substr(0, lower.size()) == lower) {
        -:  164:            result.push_back(word);
        -:  165:            if (result.size() >= 10) break;
        -:  166:        }
        -:  167:    }
        -:  168:    return result;
        -:  169:}
