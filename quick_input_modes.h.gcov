        -:   66:// u 模式查表：给定笔画代码（如 "hsp"），返回匹配的汉字列表
        -:   67:inline std::vector<std::string> u_mode_lookup(const std::string &strokes) {
        -:   68:    const auto &table = stroke_table();
        -:   69:    // 精确匹配
        -:   70:    for (const auto &[code, chars] : table) {
        -:   71:        if (code == strokes) return chars;
        -:   72:    }
        -:   73:    // 前缀匹配：返回所有以 strokes 为前缀的笔画对应的汉字（去重）
        -:   74:    std::vector<std::string> result;
        -:   75:    for (const auto &[code, chars] : table) {
        -:   76:        if (code.size() > strokes.size() &&
        -:   77:            code.substr(0, strokes.size()) == strokes) {
        -:   78:            for (const auto &c : chars) {
        -:   79:                if (std::find(result.begin(), result.end(), c) == result.end()) {
        -:   80:                    result.push_back(c);
        -:   81:                }
        -:   82:            }
        -:   83:        }
        -:   84:    }
        -:   85:    return result;
        -:   86:}
