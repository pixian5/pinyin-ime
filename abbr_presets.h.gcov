        -:  592:        {"buky", "不可以"},             // 不可以
        -:  593:        // v0.9.114: 元音尾词（辅音+元音，元音独立成字）——通用组合机制
        -:  594:        // 这些词本身 libime 能出（ha→好啊），但作为长简拼末尾时会被合并成音节
        -:  595:        // （jrmsha→进入秒杀，而非"家人们好啊"）。boost_abbreviation 会把它们
        -:  596:        // 与前面的简拼词组合（前缀词+尾词），从而让任意"…辅音元音"都能出"X好X"。
        -:  597:        {"ha", "好啊"},                 // h=好 + a=啊
        -:  598:        {"ho", "好哦"},                 // h=好 + o=哦
        -:  599:        {"he", "好呃"},                 // h=好 + e=呃
        -:  600:        {"hi", "嗨"},                   // h + i（嗨/嗨呀）
