# 基线评测容器（Ubuntu 24.04 noble，libime 1.1.5）：用于重跑整句基线，
# 把「词库版本」从「引擎 vs 词库规模」的对比里分离出来。
#
# 与 Debian 12（libime 1.0.16，见 docker/Dockerfile）的区别：
#   - noble 的 libimepinyin-dev 打包完整（含 core 头文件与 cmake 配置），
#     可以直接 cmake 构建，不需要 Debian 那套手写 g++ 与逐项补装。
#   - 数据文件是 sc.lm / sc.dict，装在标准前缀 /usr/share/libime/ 下。
#
# 用法（在项目根目录）:
#   docker build -f docker/Dockerfile.noble -t pinyin-bench-1.1.5 .
#   docker run --rm -v "$PWD/bench":/bench -w /bench pinyin-bench-1.1.5 \
#     python3 run_bench.py --corpus corpus/news.txt --cli /src/build/libime_bench
#
# 对比 1.0.16：两个容器各跑一遍 news.txt，对照两份 summary JSON / _cases.csv。
# libime_bench 启动时会把 lm/dict 路径与字节数打到 stderr，用这行核对 sc.dict 规模是否变化。
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# noble 上 libime 系列打包完整，一次装齐即可 cmake 构建。
# libime-data / libime-data-language-model 提供 sc.dict / sc.lm；
# libboost-dev / libfcitx5utils-dev 提供编译所需头文件。
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++ \
        pkg-config \
        libimepinyin-dev \
        libimecore-dev \
        libboost-dev \
        libfcitx5utils-dev \
        libime-data \
        libime-data-language-model \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 确认装的版本与数据文件实际位置（sc.dict 规模是「词库版本」的关键证据）
RUN echo "--- libime 版本 ---"; dpkg -l 2>/dev/null | grep -i libime | awk '{print $2, $3}'; \
    echo "--- 语言模型 ---"; find / -name "*.lm" 2>/dev/null | head -5; \
    echo "--- sc.dict ---"; find / -name "sc.dict" 2>/dev/null -exec ls -l {} \;

COPY cpp /src
WORKDIR /src

# noble 打包完整，正常走 cmake（不像 Debian 12 要手写 g++）
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j"$(nproc)"

# 构建期冒烟：能打出"你好"并回显词库规模就说明库、sc.lm、sc.dict 都就位
RUN echo "nihao" | ./build/libime_bench

# 评测脚本依赖（pypinyin 生成 gold、opencc 繁转简、jieba 分词）
COPY bench/requirements.txt /bench_requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /bench_requirements.txt \
    || pip3 install --no-cache-dir -r /bench_requirements.txt

WORKDIR /bench
CMD ["/src/build/libime_bench"]