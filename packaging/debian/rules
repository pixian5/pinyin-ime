#!/usr/bin/make -f
# Debian packaging rules for pinyin-ime

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export PREFIX := /usr

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DLIBIME_INCLUDE_DIR=/usr/include/libime \
		-DLIBIME_LIBRARY=/usr/lib/$(DEB_HOST_MULTIARCH)/libime.so

override_dh_auto_build:
	dh_auto_build -- -j$$(nproc)
	# Build CLI
	cd cpp && cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr && \
		cmake --build build

override_dh_auto_install:
	dh_auto_install
	# Install CLI
	cd cpp && cmake --install build --prefix $(CURDIR)/debian/pinyin-ime/usr
	# Install scripts
	install -Dm755 scripts/benchmark.py $(CURDIR)/debian/pinyin-ime/usr/share/pinyin-ime/scripts/benchmark.py
	install -Dm755 scripts/user_dict.py $(CURDIR)/debian/pinyin-ime/usr/share/pinyin-ime/scripts/user_dict.py
	install -Dm755 scripts/user_dict_import.py $(CURDIR)/debian/pinyin-ime/usr/share/pinyin-ime/scripts/user_dict_import.py
	# Install docs
	install -Dm644 docs/QUICKSTART.md $(CURDIR)/debian/pinyin-ime/usr/share/doc/pinyin-ime/QUICKSTART.md
	install -Dm644 docs/FEATURES.md $(CURDIR)/debian/pinyin-ime/usr/share/doc/pinyin-ime/FEATURES.md
	install -Dm644 docs/EVALUATION.md $(CURDIR)/debian/pinyin-ime/usr/share/doc/pinyin-ime/EVALUATION.md

override_dh_missing:
	dh_missing --fail-missing
